    <!-- Permissions wizard -->
    <string name="permissions_intro">Go through the steps in order. Green means everything is fine.</string>
    <string name="perm_ok">OK</string>
    <string name="perm_missing">Missing</string>
    <string name="perm_fix">Fix</string>
    <string name="perm_exact_title">Exact alarms</string>
    <string name="perm_exact_desc">Without this, Android may delay the alarm by several minutes.</string>
    <string name="perm_notif_title">Notifications</string>
    <string name="perm_notif_desc">Needed to show the alarm with the \"Snooze\" and \"Stop\" buttons.</string>
    <string name="perm_battery_title">Battery optimization</string>
    <string name="perm_battery_desc">Turn off battery optimization for AB Alarm so the system does not put it to sleep.</string>
    <string name="perm_fullscreen_title">Show over lock screen</string>
    <string name="perm_fullscreen_desc">Lets the alarm appear full screen while the phone is locked.</string>
    <string name="perm_oem_title">Extra steps for your phone</string>
    <string name="perm_oem_other">No extra steps are needed for your phone.</string>
    <string name="open_app_settings">Open app settings</string>
    <string name="oem_xiaomi">Xiaomi / Redmi / POCO (MIUI, HyperOS):\n1. Settings → Apps → AB Alarm → turn on \"Autostart\".\n2. Battery saver → choose \"No restrictions\".\n3. In the recent apps list, lock AB Alarm (padlock icon).</string>
    <string name="oem_huawei">Huawei / Honor (EMUI, MagicOS):\n1. Settings → Battery → App launch → AB Alarm.\n2. Turn off \"Manage automatically\" and turn on all three options: auto-launch, secondary launch and run in background.</string>
    <string name="oem_oppo">OPPO / realme / OnePlus (ColorOS):\n1. Settings → Apps → AB Alarm → allow \"Auto launch\".\n2. Battery usage → allow background activity.\n3. In the recent apps list, lock AB Alarm.</string>
    <string name="oem_vivo">vivo / iQOO (Funtouch OS, OriginOS):\n1. i Manager → App manager → Autostart → turn on AB Alarm.\n2. Settings → Battery → High background power consumption → allow AB Alarm.</string>

